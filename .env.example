# Application Settings
APP_NAME=RGPV-Agent
ENV=development
DEBUG=True
API_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rgpv_agent
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/rgpv_agent
POSTGRES_SYNC_URL=postgresql://postgres:postgrespassword@localhost:5432/rgpv_agent

# LLM Providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_MODEL=gemini-1.5-pro

# Observability & Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# File Storage
UPLOAD_DIR=./uploads
REFERENCE_DATA_DIR=./data/reference
MAX_UPLOAD_SIZE_MB=15
